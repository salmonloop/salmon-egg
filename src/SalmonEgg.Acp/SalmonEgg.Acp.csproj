<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>true</IsPackable>

    <!-- SDK 硬约束：AOT/trim 安全 + 零警告门禁。协议序列化全走源生成 (AcpJsonContext)，
         多态转换器已改用 GetTypeInfo，故 AOT/trim 干净；两开关让后续的 AOT/警告退化当场变红。 -->
    <IsAotCompatible>true</IsAotCompatible>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PackageId>SalmonEgg.Acp</PackageId>
    <Title>SalmonEgg ACP SDK</Title>
    <Description>ACP protocol contracts and SDK primitives used by SalmonEgg.</Description>
    <Authors>SalmonEgg</Authors>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://agentclientprotocol.com/</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
