<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>true</IsPackable>

    <!-- SDK 硬约束：AOT/trim 安全 + 零警告门禁。协议序列化全走源生成 (AcpJsonContext)，
         多态转换器已改用 GetTypeInfo，故 AOT/trim 干净；两开关让后续的 AOT/警告退化当场变红。 -->
    <IsAotCompatible>true</IsAotCompatible>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PackageId>SalmonEgg.Acp</PackageId>
    <Title>SalmonEgg ACP SDK</Title>
    <Description>ACP protocol contracts and SDK primitives used by SalmonEgg.</Description>
    <Authors>SalmonEgg</Authors>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://agentclientprotocol.com/</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- 内部实现细节（JsonRpc 信封、消息解析/校验、源生成上下文）对 SDK 自有测试工程开放，
       其余消费者只经由 public 契约（IAcpClient / DTO / 宿主接缝）访问。 -->
  <ItemGroup>
    <InternalsVisibleTo Include="SalmonEgg.Acp.Tests" />
    <InternalsVisibleTo Include="SalmonEgg.Application.Tests" />
  </ItemGroup>

</Project>
