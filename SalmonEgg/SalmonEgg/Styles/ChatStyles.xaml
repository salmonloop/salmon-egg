<ResourceDictionary
    x:Class="SalmonEgg.Styles.ChatStyles"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SalmonEgg.Presentation.ViewModels.Chat"
    xmlns:controls="using:SalmonEgg.Controls"
    xmlns:converters="using:SalmonEgg.Presentation.Converters">

    <!-- SSOT Common Chat Converters -->
    <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
    <converters:TimeFormatConverter x:Key="TimeFormatConverter"/>
    <converters:MessageDirectionToAlignmentConverter x:Key="MessageDirectionToAlignmentConverter"/>

    <!-- Shared Style for AI left-reference line -->
    <Style x:Key="IncomingMessageBorderStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="2,0,0,0" />
        <Setter Property="Padding" Value="16,0,0,8" />
        <!-- Transparent (non-null) background makes the whole bubble hit-testable so ContextRequested fires over markdown block gaps, not just directly on glyphs. -->
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <DataTemplate x:Key="IncomingMessageTemplate" x:DataType="vm:ChatMessageViewModel">
        <Grid Margin="0,8"
              HorizontalAlignment="{x:Bind IsOutgoing, Mode=OneWay, Converter={StaticResource MessageDirectionToAlignmentConverter}}">
            <!-- ContextFlyout is leaf-owned, not on this Border. The body text (plain TextBlock
                 and the markdown host) has IsTextSelectionEnabled, so each installs its own
                 text-selection command bar and marks the bubbling ContextRequested handled; a
                 Border-level flyout would only ever fire in the empty left-rule/padding gap, never
                 over the text. Copy/Report therefore live on the actual right-click leaves — the
                 plain TextBlock directly, and the markdown host via MarkdownTextPresenter's
                 ContextMenuFlyout forward (AGENTS.md §7). -->
            <Border Style="{StaticResource IncomingMessageBorderStyle}">
                <StackPanel>
                    <!-- Header Metadata: only shown when the message carries an authoritative time. -->
                    <TextBlock Text="{x:Bind Timestamp, Mode=OneWay, Converter={StaticResource TimeFormatConverter}}"
                               Visibility="{x:Bind HasTimestamp, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                               FontSize="11"
                               Foreground="{ThemeResource TextFillColorDisabledBrush}"
                               HorizontalAlignment="Left"
                               Margin="0,0,0,8"/>

                    <Grid x:Name="IncomingTextContentHost"
                          Visibility="{x:Bind HasDisplayBody, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock x:Name="IncomingPlainTextBlock"
                                   x:Load="{x:Bind MarkdownPresentation.ShouldRenderPlainText, Mode=OneWay}"
                                   Text="{x:Bind DisplayBodyText, Mode=OneWay}"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                   LineHeight="22"
                                   LineStackingStrategy="BlockLineHeight"
                                   IsTextSelectionEnabled="True">
                            <TextBlock.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem x:Uid="ChatMessageCopyMenu"
                                                    Command="{x:Bind CopyTextCommand}"
                                                    CommandParameter="{x:Bind DisplayBodyText, Mode=OneWay}" />
                                    <MenuFlyoutItem x:Uid="ChatMessageReportMenu"
                                                    Command="{x:Bind ReportContentCommand}" />
                                </MenuFlyout>
                            </TextBlock.ContextFlyout>
                        </TextBlock>

                        <controls:MarkdownTextPresenter x:Name="IncomingMarkdownPresenter"
                                                        x:Load="{x:Bind MarkdownPresentation.ShouldRenderMarkdown, Mode=OneWay}"
                                                        Text="{x:Bind DisplayBodyText, Mode=OneWay}"
                                                        ShouldRenderMarkdown="{x:Bind MarkdownPresentation.ShouldRenderMarkdown, Mode=OneWay}"
                                                        RenderFailureSink="{x:Bind}"
                                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                        LinkForeground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                        CodeBlockBackground="{ThemeResource ControlFillColorSecondaryBrush}"
                                                        CodeBlockForeground="{ThemeResource TextFillColorPrimaryBrush}"
                                                        CodeBlockBorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                        InlineCodeBackground="{ThemeResource ControlFillColorTertiaryBrush}"
                                                        InlineCodeForeground="{ThemeResource TextFillColorPrimaryBrush}"
                                                        InlineCodeBorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                        QuoteBackground="{ThemeResource ControlFillColorSecondaryBrush}"
                                                        QuoteForeground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        QuoteBorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                                        TableBorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                        LinkCommand="{x:Bind OpenMarkdownLinkCommand}"
                                                        IsTextSelectionEnabled="{x:Bind MarkdownPresentation.AllowsNativeSelection, Mode=OneWay}">
                            <controls:MarkdownTextPresenter.ContextMenuFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem x:Uid="ChatMessageCopyMenu"
                                                    Command="{x:Bind CopyTextCommand}"
                                                    CommandParameter="{x:Bind DisplayBodyText, Mode=OneWay}" />
                                    <MenuFlyoutItem x:Uid="ChatMessageReportMenu"
                                                    Command="{x:Bind ReportContentCommand}" />
                                </MenuFlyout>
                            </controls:MarkdownTextPresenter.ContextMenuFlyout>
                        </controls:MarkdownTextPresenter>

                        <Button x:Name="IncomingMarkdownCopyCodeButton"
                                x:Uid="ChatMarkdownCopyCodeButton"
                                x:Load="{x:Bind MarkdownPresentation.HasCopyableCodeBlock, Mode=OneWay}"
                                Command="{x:Bind CopyTextCommand}"
                                CommandParameter="{x:Bind MarkdownPresentation.CopyableCodeBlockText, Mode=OneWay}"
                                AutomationProperties.AutomationId="ChatMessage.CopyCodeButton"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Width="32"
                                Height="32"
                                MinWidth="32"
                                Padding="0"
                                Margin="8,0,0,0"
                                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">
                            <SymbolIcon Symbol="Copy" />
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="OutgoingMessageTemplate" x:DataType="vm:ChatMessageViewModel">
        <Grid Margin="0,8"
              HorizontalAlignment="{x:Bind IsOutgoing, Mode=OneWay, Converter={StaticResource MessageDirectionToAlignmentConverter}}">
            <!-- ContextFlyout is leaf-owned, not on this Border. OutgoingPlainTextBlock has
                 IsTextSelectionEnabled, so it installs its own text-selection command bar and marks
                 the bubbling ContextRequested handled; a Border-level flyout would never fire over
                 the text. Copy therefore lives on the text leaf (AGENTS.md §7). -->
            <Border CornerRadius="12,12,0,12"
                    Padding="16,10"
                    BorderThickness="0">
                <Border.Background>
                    <SolidColorBrush Color="{ThemeResource SystemAccentColor}" Opacity="0.15" />
                </Border.Background>
                <StackPanel x:Name="OutgoingMessageContentRoot">
                    <!-- Header Metadata: only shown when the message carries an authoritative time. -->
                    <TextBlock Text="{x:Bind Timestamp, Mode=OneWay, Converter={StaticResource TimeFormatConverter}}"
                               Visibility="{x:Bind HasTimestamp, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                               FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Right"
                               Margin="0,0,0,4"/>

                    <TextBlock x:Name="OutgoingPlainTextBlock"
                               x:Load="{x:Bind HasDisplayBody, Mode=OneWay}"
                               Text="{x:Bind DisplayBodyText, Mode=OneWay}"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               IsTextSelectionEnabled="True">
                        <TextBlock.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem x:Uid="ChatMessageCopyMenu"
                                                Command="{x:Bind CopyTextCommand}"
                                                CommandParameter="{x:Bind DisplayBodyText, Mode=OneWay}" />
                            </MenuFlyout>
                        </TextBlock.ContextFlyout>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="ToolCallMessageTemplate" x:DataType="vm:ChatMessageViewModel">
        <Grid Margin="0,8"
              HorizontalAlignment="{x:Bind IsOutgoing, Mode=OneWay, Converter={StaticResource MessageDirectionToAlignmentConverter}}">
            <!-- ContextFlyout is leaf-owned inside the pill, not on this Border. The pill hosts
                 selectable text (title/summary/detail/raw), so a Border-level flyout would only fire
                 in the empty left-rule/padding gap. Copy/Report are projected into the pill's command
                 DPs; the pill installs the right-click menu on its own root leaf (AGENTS.md §7). -->
            <Border Style="{StaticResource IncomingMessageBorderStyle}">
                <StackPanel>
                    <!-- Header Metadata: only shown when the message carries an authoritative time. -->
                    <TextBlock Text="{x:Bind Timestamp, Mode=OneWay, Converter={StaticResource TimeFormatConverter}}"
                               Visibility="{x:Bind HasTimestamp, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                               FontSize="11"
                               Foreground="{ThemeResource TextFillColorDisabledBrush}"
                               HorizontalAlignment="Left"
                               Margin="0,0,0,8"/>

                    <controls:ToolCallPill x:Name="ToolCallMessagePill"
                                           x:Load="{x:Bind ShouldShowToolCallPill, Mode=OneWay}"
                                           Visibility="{x:Bind ShouldShowToolCallPill, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                           CopyCommand="{x:Bind CopyTextCommand}"
                                           CopyCommandParameter="{x:Bind DisplayBodyText, Mode=OneWay}"
                                           ReportCommand="{x:Bind ReportContentCommand}"
                                           ToolTitle="{x:Bind Title, Mode=OneWay}"
                                           ToolKind="{x:Bind ToolCallKind, Mode=OneWay}"
                                           Status="{x:Bind ToolCallStatus, Mode=OneWay}"
                                           IsInProgress="{x:Bind IsToolCallInProgress, Mode=OneWay}"
                                           IsCompleted="{x:Bind IsToolCallCompleted, Mode=OneWay}"
                                           IsFailed="{x:Bind IsToolCallFailed, Mode=OneWay}"
                                           IsCancelled="{x:Bind IsToolCallCancelled, Mode=OneWay}"
                                           Summary="{x:Bind ToolCallSummary, Mode=OneWay}"
                                           RawInput="{x:Bind ToolCallRawInputJson, Mode=OneWay}"
                                           RawOutput="{x:Bind ToolCallRawOutputJson, Mode=OneWay}"
                                           DetailItems="{x:Bind ToolCallDetailItems, Mode=OneWay}"
                                           PendingPermissionRequest="{x:Bind PendingPermissionRequest, Mode=OneWay}" />
                </StackPanel>
            </Border>
        </Grid>
    </DataTemplate>

    <converters:MessageTemplateSelector x:Key="MessageTemplateSelector"
                                        IncomingTemplate="{StaticResource IncomingMessageTemplate}"
                                        OutgoingTemplate="{StaticResource OutgoingMessageTemplate}"
                                        ToolCallTemplate="{StaticResource ToolCallMessageTemplate}" />
</ResourceDictionary>
