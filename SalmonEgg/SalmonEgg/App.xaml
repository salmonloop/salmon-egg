<Application x:Class="SalmonEgg.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:win="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:controls="using:Microsoft.UI.Xaml.Controls"
             xmlns:styles="using:SalmonEgg.Styles">

    <Application.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <!-- WinUI 3 default control resources (provides TextFillColorPrimaryBrush, etc.) -->
                    <controls:XamlControlsResources />
                    <ResourceDictionary Source="ms-appx:///Styles/TitleBarIcons.xaml" />
                    <ResourceDictionary Source="ms-appx:///Styles/TitleBarCommandButtonStyle.xaml" />
                    <ResourceDictionary Source="ms-appx:///Styles/TitleBarToggleButtonStyle.xaml" />
                    <styles:ChatStyles />
                </ResourceDictionary.MergedDictionaries>

            <!-- 兼容性资源定义：确保在所有平台上都有回退项 -->
            <ResourceDictionary.ThemeDictionaries>
                <!--
                  Card/surface fill that still lets the window backdrop (Mica/DesktopAcrylic/AppBackdropBrush) show through.
                  Using AcrylicBrush keeps the "material" feel instead of a flat solid fill.
                -->
                <ResourceDictionary x:Key="Light">
                    <AcrylicBrush x:Key="LayerOnAcrylicFillColorDefaultBrush"
                                  TintColor="{StaticResource SystemAltHighColor}"
                                  TintOpacity="0.55"
                                  FallbackColor="{StaticResource SystemAltHighColor}" />
                    <SolidColorBrush x:Key="AppOverlayScrimBrush"
                                     Color="{StaticResource SystemBaseHighColor}"
                                     Opacity="0.25" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <AcrylicBrush x:Key="LayerOnAcrylicFillColorDefaultBrush"
                                  TintColor="{StaticResource SystemAltHighColor}"
                                  TintOpacity="0.45"
                                  FallbackColor="{StaticResource SystemAltHighColor}" />
                    <SolidColorBrush x:Key="AppOverlayScrimBrush"
                                     Color="{StaticResource SystemBaseLowColor}"
                                     Opacity="0.25" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <StaticResource x:Key="LayerOnAcrylicFillColorDefaultBrush" ResourceKey="SystemColorWindowColorBrush" />
                    <StaticResource x:Key="AppOverlayScrimBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <!--
              The one base every list-row container style chains to. App styles must chain here,
              never to DefaultListViewItemStyle directly, because the right base differs per
              platform and the win: prefix below is what states that difference.

              On WinUI an ItemContainerStyle REPLACES the framework's implicit ListViewItem style
              rather than merging with it, and that implicit style declares no setters of its own -
              its whole content is BasedOn="{StaticResource DefaultListViewItemStyle}". A container
              style that does not re-chain therefore loses the Template, and with it the
              ListViewItemPresenter that draws the selection indicator, corner radius and hover fill.

              Uno inverts both halves. FrameworkElement.ApplyStyles applies the explicit style and
              then the default style at the lower ImplicitStyle precedence, so a Template arrives
              even when the explicit style omits one; and its keyed DefaultListViewItemStyle wraps a
              ListViewItemPresenter Uno has never implemented (unoplatform/uno#1444) in a template
              with zero VisualStateGroups. Chaining to it there would promote that empty template to
              ExplicitStyle precedence and shadow the working ListViewItemExpanded template Uno
              installs by default, costing the state fills. So the base must be absent there.

              win: is Uno's conditional-XAML prefix for "Windows only" (Uno.UI.SourceGenerators.props
              lists win in ExcludeXamlNamespaces unconditionally, so its generator drops the
              attribute; on Windows the prefix maps to the default presentation namespace, making
              win:BasedOn simply BasedOn). One declaration, correct on both.

              CornerRadius belongs here rather than at each call site: Uno's row template
              template-binds it from the container and defines no ListViewItem radius resource, so
              omitting it renders square rows there, while WinUI's presenter reads
              ThemeResource ListViewItemCornerRadius and ignores this setter. ControlCornerRadius is
              used because Uno ships no ListViewItemCornerRadius; both are 4.
            -->
            <Style x:Key="AppListRowBaseStyle" TargetType="ListViewItem" win:BasedOn="{StaticResource DefaultListViewItemStyle}">
                <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
            </Style>

            <SolidColorBrush x:Key="AccentBrush" Color="{ThemeResource SystemAccentColor}" />
            <SolidColorBrush x:Key="AppTerminalSurfaceBrush" Color="{ThemeResource SystemAltHighColor}" />
            <FontFamily x:Key="AppMonospaceFontFamily">Consolas</FontFamily>

            <!-- Settings layout (Win11-like): fixed content column on wide windows, fluid on narrow ones -->
            <x:Double x:Key="SettingsContentMaxWidth">780</x:Double>
            <Thickness x:Key="SettingsPageVerticalPadding">0,0,0,16</Thickness>
            <Thickness x:Key="SettingsSectionContainerPadding">0</Thickness>
            <Thickness x:Key="SettingsRowPadding">16,14</Thickness>
            <x:Double x:Key="SettingsRowControlMinWidth">220</x:Double>

            <Style x:Key="SettingsPageTitleTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="SettingsPageSummaryTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="MaxWidth" Value="{StaticResource SettingsContentMaxWidth}" />
            </Style>

            <Style x:Key="SettingsSectionTitleTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="SettingsRowTitleTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="SettingsRowDescriptionTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="SettingsSectionContainerStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="{StaticResource SettingsSectionContainerPadding}" />
            </Style>

            <Style x:Key="SettingsRowGridStyle" TargetType="Grid">
                <Setter Property="Padding" Value="{StaticResource SettingsRowPadding}" />
                <Setter Property="ColumnSpacing" Value="16" />
                <Setter Property="RowSpacing" Value="4" />
            </Style>

            <!-- Win11-like breadcrumb (merged with title) -->
            <Style x:Key="SettingsBreadcrumbLinkStyle" TargetType="HyperlinkButton">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="FontSize" Value="30" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- Standard BreadcrumbBar item text (used by SettingsBreadcrumbBar control). -->
            <Style x:Key="SettingsBreadcrumbBarTextStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="0" />
                <Setter Property="FontSize" Value="30" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="SettingsBreadcrumbCurrentTextStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="0" />
                <Setter Property="FontSize" Value="30" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="SettingsBreadcrumbSeparatorTextStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="0" />
                <Setter Property="FontSize" Value="30" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Opacity" Value="0.55" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="ComposerTextBoxStyle"
                   TargetType="TextBox"
                   BasedOn="{StaticResource DefaultTextBoxStyle}">
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="PlaceholderForeground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <Style TargetType="TextBox"
                   BasedOn="{StaticResource DefaultTextBoxStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="PlaceholderForeground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <Style TargetType="PasswordBox"
                   BasedOn="{StaticResource DefaultPasswordBoxStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            </Style>

            <Style TargetType="NumberBox">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            </Style>

            <!-- App backdrop (Mica-like) fallback usable across platforms -->
            <AcrylicBrush x:Key="AppBackdropBrush"
                          TintColor="{ThemeResource SystemAltHighColor}"
                          TintOpacity="0.85"
                          FallbackColor="{ThemeResource SystemAltHighColor}" />

        </ResourceDictionary>
    </Application.Resources>

</Application>
