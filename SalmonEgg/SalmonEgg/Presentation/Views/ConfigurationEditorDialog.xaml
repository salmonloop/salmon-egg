<ContentDialog
    x:Class="SalmonEgg.Presentation.Views.ConfigurationEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:SalmonEgg.Presentation.Converters"
    xmlns:vm="using:SalmonEgg.Presentation.ViewModels"
    xmlns:views="using:SalmonEgg.Presentation.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Uid="ConfigurationEditorDialog"
    PrimaryButtonClick="OnSaveClick"
    SecondaryButtonClick="OnCancelClick">

    <ContentDialog.Resources>
        <Style TargetType="views:ConfigurationEditorDialog"
               BasedOn="{StaticResource DefaultContentDialogStyle}" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </ContentDialog.Resources>

    <Grid>
        <!-- Short windows: densify editor stack spacing. Comfortable restores Spacing=12 at
             MinWindowHeight=760. ScrollViewer still owns overflow for the form fields. -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ConfigurationEditorHeightStates">
                <VisualState x:Name="ConfigurationEditorHeightCompact">
                    <VisualState.Setters>
                        <Setter Target="ConfigurationEditorContent.Spacing" Value="8" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="ConfigurationEditorHeightComfortable">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowHeight="760" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ConfigurationEditorContent.Spacing" Value="12" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="ConfigurationEditorContent"
                    Spacing="8"
                    MaxWidth="560"
                    Padding="4"
                    HorizontalAlignment="Stretch">
            <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                     Severity="Error"
                     IsClosable="True"
                     Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"/>

            <TextBox x:Uid="ConfigurationEditorDialogName"
                     Text="{x:Bind ViewModel.Name, Mode=TwoWay}"/>

            <ComboBox x:Uid="ConfigurationEditorDialogTransport"
                      ItemsSource="{x:Bind ViewModel.TransportOptions, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SelectedTransportOption, Mode=TwoWay}"
                      IsFocusEngagementEnabled="True">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:TransportOption">
                        <TextBlock Text="{x:Bind Name, Mode=OneWay}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <StackPanel Spacing="12"
                        Visibility="{x:Bind ViewModel.IsStdio, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBox x:Uid="ConfigurationEditorDialogCommand"
                         Text="{x:Bind ViewModel.StdioCommand, Mode=TwoWay}"/>
                <TextBox x:Uid="ConfigurationEditorDialogArgs"
                         Text="{x:Bind ViewModel.StdioArgumentsText, Mode=TwoWay}"/>
            </StackPanel>

            <StackPanel Spacing="12"
                        Visibility="{x:Bind ViewModel.IsRemote, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBox x:Uid="ConfigurationEditorDialogServerUrl"
                         Text="{x:Bind ViewModel.ServerUrl, Mode=TwoWay}"/>
            </StackPanel>

            <TextBlock x:Uid="ConfigurationEditorDialogHint"
                       Style="{StaticResource SettingsRowDescriptionTextStyle}"
                       TextWrapping="Wrap"/>
            <Expander Header="{x:Bind ViewModel.CredentialBindingTitle, Mode=OneWay}"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="12">
                    <TextBlock Text="{x:Bind ViewModel.CredentialKeepHint, Mode=OneWay}"
                               Style="{StaticResource SettingsRowDescriptionTextStyle}"
                               TextWrapping="Wrap"/>
                    <PasswordBox x:Uid="AgentProfileEditorToken"
                                 Password="{x:Bind ViewModel.Token, Mode=TwoWay}"
                                 IsEnabled="{x:Bind ViewModel.IsCredentialInputEnabled, Mode=OneWay}"/>
                    <PasswordBox x:Uid="AgentProfileEditorApiKey"
                                 Password="{x:Bind ViewModel.ApiKey, Mode=TwoWay}"
                                 IsEnabled="{x:Bind ViewModel.IsCredentialInputEnabled, Mode=OneWay}"/>
                    <CheckBox Content="{x:Bind ViewModel.CredentialClearLabel, Mode=OneWay}"
                              IsChecked="{x:Bind ViewModel.ClearCredentialsOnSave, Mode=TwoWay}"/>
                    <TextBlock Text="{x:Bind ViewModel.CredentialBindingHint, Mode=OneWay}"
                               Style="{StaticResource SettingsRowDescriptionTextStyle}"
                               TextWrapping="Wrap"/>
                    <ComboBox Header="{x:Bind ViewModel.CredentialSourceLabel, Mode=OneWay}"
                              HorizontalAlignment="Stretch"
                              ItemsSource="{x:Bind ViewModel.CredentialSourceOptions, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedCredentialSourceOption, Mode=TwoWay}"
                              IsFocusEngagementEnabled="True">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:CredentialSourceOption">
                                <TextBlock Text="{x:Bind Name, Mode=OneWay}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBox Header="{x:Bind ViewModel.CredentialNameLabel, Mode=OneWay}"
                             Text="{x:Bind ViewModel.CredentialName, Mode=TwoWay}"/>
                    <TextBox Header="{x:Bind ViewModel.CredentialSchemeLabel, Mode=OneWay}"
                             Visibility="{x:Bind ViewModel.IsRemote, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                             Text="{x:Bind ViewModel.CredentialScheme, Mode=TwoWay}"/>
                    <Button Content="{x:Bind ViewModel.CredentialBindLabel, Mode=OneWay}"
                            Command="{x:Bind ViewModel.BindCredentialCommand}"/>
                    <TextBlock Text="{x:Bind ViewModel.CredentialBindingSummary, Mode=OneWay}"
                               Style="{StaticResource SettingsRowDescriptionTextStyle}"
                               TextWrapping="Wrap"/>
                    <Button Content="{x:Bind ViewModel.CredentialUnbindLabel, Mode=OneWay}"
                            Command="{x:Bind ViewModel.RemoveCredentialBindingCommand}"/>
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
    </Grid>
</ContentDialog>
