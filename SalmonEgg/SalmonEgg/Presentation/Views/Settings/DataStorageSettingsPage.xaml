<views:SettingsPageBase
    x:Class="SalmonEgg.Presentation.Views.Settings.DataStorageSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SalmonEgg.Controls"
    xmlns:views="using:SalmonEgg.Presentation.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:SalmonEgg.Presentation.Converters"
    mc:Ignorable="d"
    Background="Transparent"
    AllowDrop="False">

    <Page.Resources>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Page.Resources>

    <ScrollViewer Padding="0"
                  HorizontalScrollBarVisibility="Disabled">
        <controls:ResponsiveContentHost MaxContentWidth="{StaticResource SettingsContentMaxWidth}">
            <controls:ResponsiveContentHost.Child>
                <StackPanel Spacing="28">
                    <StackPanel Spacing="8">
                        <TextBlock x:Uid="DataStorage_PageTitle"
                                   Style="{StaticResource SettingsPageTitleTextStyle}"/>
                        <TextBlock x:Uid="DataStorage_PageSummary"
                                   Style="{StaticResource SettingsPageSummaryTextStyle}"/>
                    </StackPanel>

                    <StackPanel Spacing="12">
                        <TextBlock x:Uid="DataStorage_PrivacyTitle"
                                   Style="{StaticResource SettingsSectionTitleTextStyle}"/>

                        <Border Style="{StaticResource SettingsSectionContainerStyle}">
                            <Grid Style="{StaticResource SettingsRowGridStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center" Spacing="4">
                                    <TextBlock x:Uid="DataStorage_SaveLocalHistoryTitle"
                                               Style="{StaticResource SettingsRowTitleTextStyle}"/>
                                    <TextBlock x:Uid="DataStorage_SaveLocalHistoryDescription"
                                               Style="{StaticResource SettingsRowDescriptionTextStyle}"/>
                                </StackPanel>

                                <ToggleSwitch Grid.Column="1"
                                              x:Name="DataStorageSaveLocalHistoryToggle"
                                              x:Uid="DataStorage_SaveLocalHistorySwitch"
                                              AutomationProperties.AutomationId="DataStorage.SaveLocalHistory"
                                              IsOn="{x:Bind ViewModel.Preferences.SaveLocalHistory, Mode=TwoWay}"
                                              VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel Spacing="12">
                        <TextBlock x:Uid="DataStorage_CloudSyncTitle"
                                   Style="{StaticResource SettingsSectionTitleTextStyle}"/>

                        <Border Style="{StaticResource SettingsSectionContainerStyle}">
                            <StackPanel>
                                <Grid Style="{StaticResource SettingsRowGridStyle}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel VerticalAlignment="Center" Spacing="8">
                                        <TextBlock x:Uid="DataStorage_CloudSyncProviderTitle"
                                                   Style="{StaticResource SettingsRowTitleTextStyle}"/>
                                        <TextBlock x:Uid="DataStorage_CloudSyncDescription"
                                                   Style="{StaticResource SettingsRowDescriptionTextStyle}"/>
                                        <TextBlock x:Uid="DataStorage_CloudSyncProviderSelectionDescription"
                                                   Style="{StaticResource SettingsRowDescriptionTextStyle}"/>

                                        <Grid Padding="12"
                                              ColumnSpacing="12"
                                              Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Grid Width="32" Height="32" VerticalAlignment="Top">
                                                <FontIcon Glyph="{x:Bind ViewModel.CloudConfigStatusGlyph, Mode=OneWay}"
                                                          FontSize="18"
                                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Visibility="{x:Bind ViewModel.IsCloudConfigStatusGlyphVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                <ProgressRing AutomationProperties.AutomationId="DataStorage.CloudSync.Progress"
                                                              IsActive="{x:Bind ViewModel.IsCloudConfigProgressActive, Mode=OneWay}"
                                                              Visibility="{x:Bind ViewModel.IsCloudConfigProgressActive, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                              Width="32"
                                                              Height="32"/>
                                            </Grid>

                                            <StackPanel Grid.Column="1" Spacing="3">
                                                <TextBlock AutomationProperties.AutomationId="DataStorage.CloudSync.ConnectionStatus"
                                                           Text="{x:Bind ViewModel.CloudConfigConnectionStatusText, Mode=OneWay}"
                                                           Style="{StaticResource SettingsRowTitleTextStyle}"/>
                                                <TextBlock AutomationProperties.AutomationId="DataStorage.CloudSync.TransferStatus"
                                                           Text="{x:Bind ViewModel.CloudConfigTransferStatusText, Mode=OneWay}"
                                                           Style="{StaticResource SettingsRowDescriptionTextStyle}"/>
                                                <TextBlock AutomationProperties.AutomationId="DataStorage.CloudSync.RemoteTarget"
                                                           Text="{x:Bind ViewModel.CloudConfigRemoteTargetText, Mode=OneWay}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Visibility="{x:Bind ViewModel.CloudConfigRemoteTargetText, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                           Style="{StaticResource SettingsRowDescriptionTextStyle}"/>
                                                <TextBlock Text="{x:Bind ViewModel.CloudConfigSyncLastSyncText, Mode=OneWay}"
                                                           Visibility="{x:Bind ViewModel.CloudConfigSyncLastSyncText, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                           Style="{StaticResource SettingsRowDescriptionTextStyle}"/>
                                                <TextBlock AutomationProperties.AutomationId="DataStorage.CloudSync.Error"
                                                           Text="{x:Bind ViewModel.CloudConfigSyncErrorText, Mode=OneWay}"
                                                           Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                           TextWrapping="Wrap"
                                                           Visibility="{x:Bind ViewModel.HasCloudConfigSyncError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                           Style="{StaticResource SettingsRowDescriptionTextStyle}"/>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="{x:Bind ViewModel.CloudConfigProviderCredentialStatusText, Mode=OneWay}"
                                                   Style="{StaticResource SettingsRowDescriptionTextStyle}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1"
                                                Spacing="8"
                                                Margin="0,12,0,0"
                                                HorizontalAlignment="Stretch">
                                        <ComboBox x:Uid="DataStorage_CloudSyncProviderPicker"
                                                  AutomationProperties.AutomationId="DataStorage.CloudSync.ProviderPicker"
                                                  ItemsSource="{x:Bind ViewModel.CloudConfigProviders, Mode=OneWay}"
                                                  DisplayMemberPath="DisplayName"
                                                  SelectedValuePath="ProviderId"
                                                  SelectedValue="{x:Bind ViewModel.SelectedCloudConfigProviderId, Mode=TwoWay}"
                                                  IsFocusEngagementEnabled="True"
                                                  UseSystemFocusVisuals="True"
                                                  HorizontalAlignment="Stretch"/>
                                        <StackPanel Spacing="8"
                                                    Visibility="{x:Bind ViewModel.IsWebDavCloudConfigProviderSelected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBox x:Uid="DataStorage_CloudSyncWebDavFileUrl"
                                                     AutomationProperties.AutomationId="DataStorage.CloudSync.WebDavFileUrl"
                                                     Text="{x:Bind ViewModel.WebDavFileUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBlock x:Uid="DataStorage_CloudSyncWebDavFolderUrlDescription"
                                                       Style="{StaticResource SettingsRowDescriptionTextStyle}"/>
                                            <TextBlock Text="{x:Bind ViewModel.WebDavValidationMessage, Mode=OneWay}"
                                                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                       Visibility="{x:Bind ViewModel.WebDavValidationMessage, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                       Style="{StaticResource SettingsRowDescriptionTextStyle}"/>
                                            <TextBox x:Uid="DataStorage_CloudSyncWebDavUsername"
                                                     AutomationProperties.AutomationId="DataStorage.CloudSync.WebDavUsername"
                                                     Text="{x:Bind ViewModel.WebDavUsername, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            <PasswordBox x:Name="WebDavPasswordBox"
                                                         x:Uid="DataStorage_CloudSyncWebDavPassword"
                                                         AutomationProperties.AutomationId="DataStorage.CloudSync.WebDavPassword"
                                                         PasswordChanged="OnWebDavPasswordChanged"/>
                                        </StackPanel>
                                        <StackPanel Spacing="8"
                                                    Visibility="{x:Bind ViewModel.IsS3CloudConfigProviderSelected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBox x:Uid="DataStorage_CloudSyncS3Endpoint"
                                                     AutomationProperties.AutomationId="DataStorage.CloudSync.S3Endpoint"
                                                     Text="{x:Bind ViewModel.S3Endpoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBox x:Uid="DataStorage_CloudSyncS3Bucket"
                                                     AutomationProperties.AutomationId="DataStorage.CloudSync.S3Bucket"
                                                     Text="{x:Bind ViewModel.S3Bucket, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBlock Text="{x:Bind ViewModel.S3ValidationMessage, Mode=OneWay}"
                                                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                       Visibility="{x:Bind ViewModel.S3ValidationMessage, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                       Style="{StaticResource SettingsRowDescriptionTextStyle}"/>
                                            <TextBox x:Uid="DataStorage_CloudSyncS3Region"
                                                     AutomationProperties.AutomationId="DataStorage.CloudSync.S3Region"
                                                     Text="{x:Bind ViewModel.S3Region, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBox x:Uid="DataStorage_CloudSyncS3ObjectKey"
                                                     AutomationProperties.AutomationId="DataStorage.CloudSync.S3ObjectKey"
                                                     Text="{x:Bind ViewModel.S3ObjectKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBlock x:Uid="DataStorage_CloudSyncS3ObjectKeyDescription"
                                                       Style="{StaticResource SettingsRowDescriptionTextStyle}"/>
                                            <ToggleSwitch x:Uid="DataStorage_CloudSyncS3ForcePathStyle"
                                                          AutomationProperties.AutomationId="DataStorage.CloudSync.S3ForcePathStyle"
                                                          IsOn="{x:Bind ViewModel.S3ForcePathStyle, Mode=TwoWay}"/>
                                            <TextBox x:Uid="DataStorage_CloudSyncS3AccessKeyId"
                                                     AutomationProperties.AutomationId="DataStorage.CloudSync.S3AccessKeyId"
                                                     Text="{x:Bind ViewModel.S3AccessKeyId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            <PasswordBox x:Name="S3SecretAccessKeyBox"
                                                         x:Uid="DataStorage_CloudSyncS3SecretAccessKey"
                                                         AutomationProperties.AutomationId="DataStorage.CloudSync.S3SecretAccessKey"
                                                         PasswordChanged="OnS3SecretAccessKeyChanged"/>
                                        </StackPanel>
                                        <Button AutomationProperties.AutomationId="DataStorage.CloudSync.ConnectSelected"
                                                Content="{x:Bind ViewModel.ConnectCloudConfigProviderButtonText, Mode=OneWay}"
                                                Command="{x:Bind ViewModel.ConnectSelectedCloudConfigProviderCommand}"
                                                IsEnabled="{x:Bind ViewModel.IsCloudConfigSyncConfigured, Mode=OneWay}"
                                                HorizontalAlignment="Stretch"/>
                                        <Button x:Uid="DataStorage_CloudSyncNow"
                                                AutomationProperties.AutomationId="DataStorage.CloudSync.SyncNow"
                                                Command="{x:Bind ViewModel.SyncCloudConfigCommand}"
                                                IsEnabled="{x:Bind ViewModel.CanSyncCloudConfig, Mode=OneWay}"
                                                HorizontalAlignment="Stretch"/>
                                        <Button x:Uid="DataStorage_CloudSyncDisconnect"
                                                AutomationProperties.AutomationId="DataStorage.CloudSync.Disconnect"
                                                Command="{x:Bind ViewModel.DisconnectCloudConfigCommand}"
                                                IsEnabled="{x:Bind ViewModel.CanDisconnectCloudConfig, Mode=OneWay}"
                                                HorizontalAlignment="Stretch"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Spacing="12">
                        <TextBlock x:Uid="DataStorage_CacheTitle"
                                   Style="{StaticResource SettingsSectionTitleTextStyle}"/>

                        <Border Style="{StaticResource SettingsSectionContainerStyle}">
                            <StackPanel>
                                <Grid Style="{StaticResource SettingsRowGridStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel VerticalAlignment="Center" Spacing="4">
                                        <TextBlock x:Uid="DataStorage_CacheRetentionLabel"
                                                   Style="{StaticResource SettingsRowTitleTextStyle}"/>
                                        <TextBlock x:Uid="DataStorage_CacheRetentionDescription"
                                                   Style="{StaticResource SettingsRowDescriptionTextStyle}"/>
                                    </StackPanel>

                                    <NumberBox Grid.Column="1"
                                               AutomationProperties.AutomationId="DataStorage.CacheRetention"
                                               Value="{x:Bind ViewModel.Preferences.CacheRetentionDays, Mode=TwoWay}"
                                               Minimum="1"
                                               Maximum="60"
                                               SmallChange="1"
                                               SpinButtonPlacementMode="Inline"
                                               IsFocusEngagementEnabled="True"
                                               UseSystemFocusVisuals="True"
                                               Width="140"
                                               VerticalAlignment="Center"/>
                                </Grid>

                                <Border Height="1"
                                        Margin="16,0"
                                        Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                                <Grid Style="{StaticResource SettingsRowGridStyle}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel VerticalAlignment="Center" Spacing="4">
                                        <TextBlock x:Uid="DataStorage_CacheActionsTitle"
                                                   Style="{StaticResource SettingsRowTitleTextStyle}"/>
                                        <TextBlock x:Uid="DataStorage_CacheActionsDescription"
                                                   Style="{StaticResource SettingsRowDescriptionTextStyle}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1"
                                                Spacing="8"
                                                Margin="0,12,0,0"
                                                HorizontalAlignment="Stretch">
                                        <Button x:Uid="DataStorage_ClearCache"
                                                AutomationProperties.AutomationId="DataStorage.ClearCache"
                                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                Click="OnClearCacheClick"
                                                HorizontalAlignment="Stretch"/>
                                        <Button x:Uid="DataStorage_OpenCacheFolder"
                                                AutomationProperties.AutomationId="DataStorage.OpenCacheFolder"
                                                Command="{x:Bind ViewModel.OpenCacheFolderCommand}"
                                                IsEnabled="{x:Bind ViewModel.CanOpenExternalFiles, Mode=OneWay}"
                                                HorizontalAlignment="Stretch"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Spacing="12">
                        <TextBlock x:Uid="DataStorage_ExportTitle"
                                   Style="{StaticResource SettingsSectionTitleTextStyle}"/>

                        <Border Style="{StaticResource SettingsSectionContainerStyle}">
                            <StackPanel>
                                <Grid Style="{StaticResource SettingsRowGridStyle}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel VerticalAlignment="Center" Spacing="4">
                                        <TextBlock x:Uid="DataStorage_ExportDescription"
                                                   Style="{StaticResource SettingsRowDescriptionTextStyle}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1"
                                                Spacing="8"
                                                Margin="0,12,0,0"
                                                HorizontalAlignment="Stretch">
                                        <Button x:Uid="DataStorage_ExportMarkdown"
                                                Command="{x:Bind ViewModel.ExportCurrentSessionMarkdownCommand}"
                                                IsEnabled="{x:Bind ViewModel.CanExportLocalFiles, Mode=OneWay}"
                                                HorizontalAlignment="Stretch"/>
                                        <Button x:Uid="DataStorage_ExportJson"
                                                Command="{x:Bind ViewModel.ExportCurrentSessionJsonCommand}"
                                                IsEnabled="{x:Bind ViewModel.CanExportLocalFiles, Mode=OneWay}"
                                                HorizontalAlignment="Stretch"/>
                                    </StackPanel>
                                </Grid>

                                <Border Height="1"
                                        Margin="16,0"
                                        Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                                <Grid Style="{StaticResource SettingsRowGridStyle}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel VerticalAlignment="Center" Spacing="4">
                                        <TextBlock x:Uid="DataStorage_DiagnosticsExportTitle"
                                                   Style="{StaticResource SettingsRowTitleTextStyle}"/>
                                        <TextBlock x:Uid="DataStorage_DiagnosticsExportDescription"
                                                   Style="{StaticResource SettingsRowDescriptionTextStyle}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1"
                                                Spacing="8"
                                                Margin="0,12,0,0"
                                                HorizontalAlignment="Stretch">
                                        <Button x:Uid="DataStorage_ExportDiagnostics"
                                                Command="{x:Bind ViewModel.CreateDiagnosticsBundleCommand}"
                                                IsEnabled="{x:Bind ViewModel.CanExportLocalFiles, Mode=OneWay}"
                                                HorizontalAlignment="Stretch"/>
                                        <Button x:Uid="DataStorage_OpenExports"
                                                Command="{x:Bind ViewModel.OpenExportsFolderCommand}"
                                                IsEnabled="{x:Bind ViewModel.CanOpenExternalFiles, Mode=OneWay}"
                                                HorizontalAlignment="Stretch"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Expander IsExpanded="False">
                        <Expander.Header>
                            <TextBlock x:Uid="DataStorage_DangerTitle"
                                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                       Style="{StaticResource SettingsSectionTitleTextStyle}"/>
                        </Expander.Header>

                        <StackPanel>
                            <TextBlock x:Uid="DataStorage_DangerWarning"
                                       Margin="16,4,16,8"
                                       Style="{StaticResource SettingsRowDescriptionTextStyle}"/>

                            <Border Style="{StaticResource SettingsSectionContainerStyle}">
                                <StackPanel>
                                    <Grid Style="{StaticResource SettingsRowGridStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel VerticalAlignment="Center" Spacing="4">
                                            <TextBlock x:Uid="DataStorage_ResetDefaultsTitle"
                                                       Style="{StaticResource SettingsRowTitleTextStyle}"/>
                                            <TextBlock x:Uid="DataStorage_ResetDefaultsHint"
                                                       Style="{StaticResource SettingsRowDescriptionTextStyle}"/>
                                        </StackPanel>

                                        <Button Grid.Column="1"
                                                x:Uid="DataStorage_ResetDefaults"
                                                Click="OnResetPreferencesClick"
                                                VerticalAlignment="Center"/>
                                    </Grid>

                                    <Border Height="1"
                                            Margin="16,0"
                                            Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                                    <Grid Style="{StaticResource SettingsRowGridStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel VerticalAlignment="Center" Spacing="4">
                                            <TextBlock x:Uid="DataStorage_ClearAllDataTitle"
                                                       Style="{StaticResource SettingsRowTitleTextStyle}"/>
                                            <TextBlock x:Uid="DataStorage_ClearAllDataHint"
                                                       Style="{StaticResource SettingsRowDescriptionTextStyle}"/>
                                        </StackPanel>

                                        <Button Grid.Column="1"
                                                x:Uid="DataStorage_ClearAllData"
                                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                Click="OnClearAllLocalDataClick"
                                                VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </controls:ResponsiveContentHost.Child>
        </controls:ResponsiveContentHost>
    </ScrollViewer>
</views:SettingsPageBase>
