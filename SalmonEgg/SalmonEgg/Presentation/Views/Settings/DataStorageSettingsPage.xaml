<views:SettingsPageBase
    x:Class="SalmonEgg.Presentation.Views.Settings.DataStorageSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SalmonEgg.Controls"
    xmlns:views="using:SalmonEgg.Presentation.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:SalmonEgg.Presentation.Converters"
    mc:Ignorable="d"
    Background="Transparent"
    AllowDrop="False">

    <Page.Resources>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Page.Resources>

        <Grid>
        <!-- Short windows: densify section stack spacing so settings remain scannable without
             oversized marketing gaps. Comfortable restores Spacing=28 at MinWindowHeight=760. -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="DataStorageHeightStates">
                <VisualState x:Name="DataStorageHeightCompact">
                    <VisualState.Setters>
                        <Setter Target="DataStorageContentStack.Spacing" Value="16" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="DataStorageHeightComfortable">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowHeight="760" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="DataStorageContentStack.Spacing" Value="28" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

    <ScrollViewer Padding="0"
                  HorizontalScrollBarVisibility="Disabled">
        <controls:ResponsiveContentHost MaxContentWidth="{StaticResource SettingsContentMaxWidth}">
            <controls:ResponsiveContentHost.Child>
                <StackPanel x:Name="DataStorageContentStack"
                            Spacing="16">
                    <StackPanel Spacing="8">
                        <TextBlock x:Uid="DataStorage_PageTitle"
                                   Style="{StaticResource SettingsPageTitleTextStyle}"/>
                        <TextBlock x:Uid="DataStorage_PageSummary"
                                   Style="{StaticResource SettingsPageSummaryTextStyle}"/>
                    </StackPanel>

                    <StackPanel Spacing="12">
                        <TextBlock x:Uid="DataStorage_PrivacyTitle"
                                   Style="{StaticResource SettingsSectionTitleTextStyle}"/>

                        <Border Style="{StaticResource SettingsSectionContainerStyle}">
                            <Grid Style="{StaticResource SettingsRowGridStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center" Spacing="4">
                                    <TextBlock x:Uid="DataStorage_SaveLocalHistoryTitle"
                                               Style="{StaticResource SettingsRowTitleTextStyle}"/>
                                    <TextBlock x:Uid="DataStorage_SaveLocalHistoryDescription"
                                               Style="{StaticResource SettingsRowDescriptionTextStyle}"/>
                                </StackPanel>

                                <ToggleSwitch Grid.Column="1"
                                              x:Name="DataStorageSaveLocalHistoryToggle"
                                              x:Uid="DataStorage_SaveLocalHistorySwitch"
                                              AutomationProperties.AutomationId="DataStorage.SaveLocalHistory"
                                              IsOn="{x:Bind ViewModel.Preferences.SaveLocalHistory, Mode=TwoWay}"
                                              VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsSectionContainerStyle}">
                            <StackPanel>
                                <Grid Style="{StaticResource SettingsRowGridStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel VerticalAlignment="Center" Spacing="4">
                                        <TextBlock x:Uid="DataStorage_TelemetrySharingTitle"
                                                   Style="{StaticResource SettingsRowTitleTextStyle}"/>
                                        <TextBlock x:Uid="DataStorage_TelemetrySharingDescription"
                                                   TextWrapping="Wrap"
                                                   Style="{StaticResource SettingsRowDescriptionTextStyle}"/>
                                    </StackPanel>

                                    <ToggleSwitch Grid.Column="1"
                                                  x:Name="DataStorageTelemetrySharingToggle"
                                                  x:Uid="DataStorage_TelemetrySharingSwitch"
                                                  AutomationProperties.AutomationId="DataStorage.TelemetrySharing"
                                                  IsOn="{x:Bind ViewModel.Preferences.TelemetrySharingEnabled, Mode=TwoWay}"
                                                  VerticalAlignment="Center"/>
                                </Grid>

                                <Border Height="1"
                                        Margin="16,0"
                                        Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                                <!-- 自定义端点属于开发者选项：默认收起，普通用户不必看到。
                                     整节随总开关联动禁用，避免"关闭上报却仍可编辑端点"的矛盾状态。 -->
                                <Expander x:Uid="DataStorage_TelemetryAdvanced"
                                          IsExpanded="False"
                                          IsEnabled="{x:Bind ViewModel.Preferences.TelemetrySharingEnabled, Mode=OneWay}"
                                          Margin="16,12,16,12"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch">
                                    <StackPanel Spacing="8" Padding="0,8,0,0">
                                        <TextBlock x:Uid="DataStorage_TelemetryAdvancedWarning"
                                                   TextWrapping="Wrap"
                                                   Style="{StaticResource SettingsRowDescriptionTextStyle}"/>
                                        <TextBox x:Uid="DataStorage_TelemetryCustomEndpoint"
                                                 AutomationProperties.AutomationId="DataStorage.TelemetryCustomEndpoint"
                                                 Text="{x:Bind ViewModel.Preferences.TelemetryCustomEndpoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBox x:Uid="DataStorage_TelemetryAuthHeader"
                                                 AutomationProperties.AutomationId="DataStorage.TelemetryAuthHeader"
                                                 Text="{x:Bind ViewModel.Preferences.TelemetryAuthHeader, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock x:Uid="DataStorage_TelemetryApplyNotice"
                                                   TextWrapping="Wrap"
                                                   Style="{StaticResource SettingsRowDescriptionTextStyle}"/>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Spacing="12">
                        <TextBlock x:Uid="DataStorage_CloudSyncTitle"
                                   Style="{StaticResource SettingsSectionTitleTextStyle}"/>

                        <Border Style="{StaticResource SettingsSectionContainerStyle}">
                            <StackPanel Spacing="12" Padding="16">
                                <TextBlock x:Uid="DataStorage_CloudSyncDescription"
                                           Style="{StaticResource SettingsRowDescriptionTextStyle}"/>

                                <Grid Padding="12"
                                      ColumnSpacing="12"
                                      Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ProgressRing AutomationProperties.AutomationId="DataStorage.CloudSync.Progress"
                                                  AutomationProperties.Name="{x:Bind ViewModel.CloudConfig.StatusHeadline, Mode=OneWay}"
                                                  IsActive="{x:Bind ViewModel.CloudConfig.IsChecking, Mode=OneWay}"
                                                  Visibility="{x:Bind ViewModel.CloudConfig.IsChecking, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                  Width="32"
                                                  Height="32"/>
                                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                              Glyph="&#xE930;"
                                              Visibility="{x:Bind ViewModel.CloudConfig.IsChecking, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <TextBlock AutomationProperties.AutomationId="DataStorage.CloudSync.ConnectionStatus"
                                                   Text="{x:Bind ViewModel.CloudConfig.StatusHeadline, Mode=OneWay}"
                                                   Style="{StaticResource SettingsRowTitleTextStyle}"/>
                                        <TextBlock AutomationProperties.AutomationId="DataStorage.CloudSync.RemoteTarget"
                                                   AutomationProperties.Name="{x:Bind ViewModel.CloudConfig.ConnectionContextText, Mode=OneWay}"
                                                   Text="{x:Bind ViewModel.CloudConfig.ConnectionContextText, Mode=OneWay}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{x:Bind ViewModel.CloudConfig.ConnectionContextText, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                   Style="{StaticResource SettingsRowDescriptionTextStyle}"/>
                                        <TextBlock AutomationProperties.AutomationId="DataStorage.CloudSync.TransferStatus"
                                                   Text="{x:Bind ViewModel.CloudConfig.TransferStatusText, Mode=OneWay}"
                                                   Style="{StaticResource SettingsRowDescriptionTextStyle}"/>
                                        <TextBlock AutomationProperties.AutomationId="DataStorage.CloudSync.Error"
                                                   Text="{x:Bind ViewModel.CloudConfig.ErrorText, Mode=OneWay}"
                                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                   TextWrapping="Wrap"
                                                   Visibility="{x:Bind ViewModel.CloudConfig.HasError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                   Style="{StaticResource SettingsRowDescriptionTextStyle}"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Orientation="Horizontal"
                                            Spacing="8"
                                            Visibility="{x:Bind ViewModel.CloudConfig.HasPendingConflict, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Button AutomationProperties.AutomationId="DataStorage.CloudSync.KeepLocal"
                                            Content="{x:Bind ViewModel.CloudConfig.KeepLocalConflictText, Mode=OneWay}"
                                            Command="{x:Bind ViewModel.CloudConfig.KeepLocalConflictCommand}"
                                            IsEnabled="{x:Bind ViewModel.CloudConfig.CanResolveConflict, Mode=OneWay}"/>
                                    <Button AutomationProperties.AutomationId="DataStorage.CloudSync.ApplyRemote"
                                            Content="{x:Bind ViewModel.CloudConfig.ApplyRemoteConflictText, Mode=OneWay}"
                                            Command="{x:Bind ViewModel.CloudConfig.ApplyRemoteConflictCommand}"
                                            IsEnabled="{x:Bind ViewModel.CloudConfig.CanResolveConflict, Mode=OneWay}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Spacing="8"
                                            Visibility="{x:Bind ViewModel.CloudConfig.IsEditing, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                    <Button x:Uid="DataStorage_CloudSyncNow"
                                            AutomationProperties.AutomationId="DataStorage.CloudSync.SyncNow"
                                            Command="{x:Bind ViewModel.CloudConfig.SyncNowCommand}"
                                            IsEnabled="{x:Bind ViewModel.CloudConfig.CanSync, Mode=OneWay}"
                                            Visibility="{x:Bind ViewModel.CloudConfig.ShowSyncAction, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <Button AutomationProperties.AutomationId="DataStorage.CloudSync.Edit"
                                            Content="{x:Bind ViewModel.CloudConfig.EditActionText, Mode=OneWay}"
                                            Command="{x:Bind ViewModel.CloudConfig.EditCommand}"
                                            IsEnabled="{x:Bind ViewModel.CloudConfig.CanEdit, Mode=OneWay}"
                                            Visibility="{x:Bind ViewModel.CloudConfig.ShowEditAction, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </StackPanel>

                                <StackPanel Spacing="8"
                                            Visibility="{x:Bind ViewModel.CloudConfig.IsEditing, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock x:Uid="DataStorage_CloudSyncUnsavedChanges"
                                               Visibility="{x:Bind ViewModel.CloudConfig.HasUnsavedChanges, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                               Style="{StaticResource SettingsRowDescriptionTextStyle}"/>
                                    <TextBlock x:Uid="DataStorage_CloudSyncSecurityNotice"
                                               TextWrapping="Wrap"
                                               Style="{StaticResource SettingsRowDescriptionTextStyle}"/>
                                    <ComboBox x:Uid="DataStorage_CloudSyncProviderPicker"
                                              AutomationProperties.AutomationId="DataStorage.CloudSync.ProviderPicker"
                                              IsFocusEngagementEnabled="True"
                                              ItemsSource="{x:Bind ViewModel.CloudConfig.Providers, Mode=OneWay}"
                                              DisplayMemberPath="DisplayName"
                                              SelectedItem="{x:Bind ViewModel.CloudConfig.SelectedProviderOption, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch"/>
                                    <StackPanel Spacing="8"
                                                Visibility="{x:Bind ViewModel.CloudConfig.IsWebDavSelected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBox x:Uid="DataStorage_CloudSyncWebDavFileUrl"
                                                 AutomationProperties.AutomationId="DataStorage.CloudSync.WebDavFileUrl"
                                                 Text="{x:Bind ViewModel.CloudConfig.WebDavFileUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBox x:Uid="DataStorage_CloudSyncWebDavUsername"
                                                 AutomationProperties.AutomationId="DataStorage.CloudSync.WebDavUsername"
                                                 Text="{x:Bind ViewModel.CloudConfig.WebDavUsername, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <PasswordBox x:Name="WebDavPasswordBox"
                                                     AutomationProperties.AutomationId="DataStorage.CloudSync.WebDavPassword"
                                                     Header="{x:Bind ViewModel.CloudConfig.WebDavPasswordHeaderText, Mode=OneWay}"
                                                     PlaceholderText="{x:Bind ViewModel.CloudConfig.WebDavPasswordPlaceholderText, Mode=OneWay}"
                                                     PasswordChanged="OnWebDavPasswordChanged"/>
                                        <TextBlock Text="{x:Bind ViewModel.CloudConfig.CredentialStatusText, Mode=OneWay}"
                                                   Style="{StaticResource SettingsRowDescriptionTextStyle}"/>
                                    </StackPanel>
                                    <StackPanel Spacing="8"
                                                Visibility="{x:Bind ViewModel.CloudConfig.IsS3Selected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBox x:Uid="DataStorage_CloudSyncS3Endpoint"
                                                 AutomationProperties.AutomationId="DataStorage.CloudSync.S3Endpoint"
                                                 Text="{x:Bind ViewModel.CloudConfig.S3Endpoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBox x:Uid="DataStorage_CloudSyncS3Bucket"
                                                 AutomationProperties.AutomationId="DataStorage.CloudSync.S3Bucket"
                                                 Text="{x:Bind ViewModel.CloudConfig.S3Bucket, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBox x:Uid="DataStorage_CloudSyncS3AccessKeyId"
                                                 AutomationProperties.AutomationId="DataStorage.CloudSync.S3AccessKeyId"
                                                 PlaceholderText="{x:Bind ViewModel.CloudConfig.S3AccessKeyIdPlaceholderText, Mode=OneWay}"
                                                 Text="{x:Bind ViewModel.CloudConfig.S3AccessKeyId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <PasswordBox x:Name="S3SecretAccessKeyBox"
                                                     AutomationProperties.AutomationId="DataStorage.CloudSync.S3SecretAccessKey"
                                                     Header="{x:Bind ViewModel.CloudConfig.S3SecretAccessKeyHeaderText, Mode=OneWay}"
                                                     PlaceholderText="{x:Bind ViewModel.CloudConfig.S3SecretAccessKeyPlaceholderText, Mode=OneWay}"
                                                     PasswordChanged="OnS3SecretAccessKeyChanged"/>
                                        <TextBlock Text="{x:Bind ViewModel.CloudConfig.CredentialStatusText, Mode=OneWay}"
                                                   Style="{StaticResource SettingsRowDescriptionTextStyle}"/>
                                        <Expander x:Uid="DataStorage_CloudSyncAdvancedSettings">
                                            <StackPanel Spacing="8">
                                                <TextBox x:Uid="DataStorage_CloudSyncS3Region"
                                                         AutomationProperties.AutomationId="DataStorage.CloudSync.S3Region"
                                                         Text="{x:Bind ViewModel.CloudConfig.S3Region, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <TextBox x:Uid="DataStorage_CloudSyncS3ObjectKey"
                                                         AutomationProperties.AutomationId="DataStorage.CloudSync.S3ObjectKey"
                                                         Text="{x:Bind ViewModel.CloudConfig.S3ObjectKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <ToggleSwitch x:Uid="DataStorage_CloudSyncS3ForcePathStyle"
                                                              AutomationProperties.AutomationId="DataStorage.CloudSync.S3ForcePathStyle"
                                                              IsOn="{x:Bind ViewModel.CloudConfig.S3ForcePathStyle, Mode=TwoWay}"/>
                                            </StackPanel>
                                        </Expander>
                                    </StackPanel>
                                    <Button AutomationProperties.AutomationId="DataStorage.CloudSync.RetryCredentialCheck"
                                            Content="{x:Bind ViewModel.CloudConfig.RetryCredentialCheckText, Mode=OneWay}"
                                            Command="{x:Bind ViewModel.CloudConfig.RetryCredentialCheckCommand}"
                                            Visibility="{x:Bind ViewModel.CloudConfig.CanRetryCredentialCheck, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                            HorizontalAlignment="Left"/>
                                    <TextBlock Text="{x:Bind ViewModel.CloudConfig.ValidationMessage, Mode=OneWay}"
                                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                               Visibility="{x:Bind ViewModel.CloudConfig.ValidationMessage, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                               Style="{StaticResource SettingsRowDescriptionTextStyle}"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button x:Uid="DataStorage_CloudSyncApplyAndVerify"
                                                AutomationProperties.AutomationId="DataStorage.CloudSync.Apply"
                                                Command="{x:Bind ViewModel.CloudConfig.ApplyCommand}"
                                                IsEnabled="{x:Bind ViewModel.CloudConfig.CanApply, Mode=OneWay}"/>
                                        <Button x:Uid="Common_Cancel"
                                                Command="{x:Bind ViewModel.CloudConfig.CancelEditCommand}"/>
                                    </StackPanel>
                                </StackPanel>

                                <Expander IsExpanded="False"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch">
                                    <Expander.Header>
                                        <TextBlock x:Uid="DataStorage_CloudSyncMoreActions"
                                                   Style="{StaticResource SettingsRowTitleTextStyle}"/>
                                    </Expander.Header>
                                    <StackPanel Spacing="8"
                                                Padding="0,8,0,0">
                                        <Button x:Uid="DataStorage_CloudSyncDisable"
                                                AutomationProperties.AutomationId="DataStorage.CloudSync.Disable"
                                                Command="{x:Bind ViewModel.CloudConfig.DisableCommand}"
                                                IsEnabled="{x:Bind ViewModel.CloudConfig.CanDisable, Mode=OneWay}"
                                                Visibility="{x:Bind ViewModel.CloudConfig.ShowDisableAction, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                HorizontalAlignment="Stretch"/>
                                        <Button x:Uid="DataStorage_CloudSyncForget"
                                                AutomationProperties.AutomationId="DataStorage.CloudSync.Forget"
                                                Command="{x:Bind ViewModel.CloudConfig.ForgetCommand}"
                                                IsEnabled="{x:Bind ViewModel.CloudConfig.CanForget, Mode=OneWay}"
                                                Visibility="{x:Bind ViewModel.CloudConfig.ShowRemoveAction, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                HorizontalAlignment="Stretch"/>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Spacing="12">
                        <TextBlock x:Uid="DataStorage_CacheTitle"
                                   Style="{StaticResource SettingsSectionTitleTextStyle}"/>

                        <Border Style="{StaticResource SettingsSectionContainerStyle}">
                            <StackPanel>
                                <Grid Style="{StaticResource SettingsRowGridStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel VerticalAlignment="Center" Spacing="4">
                                        <TextBlock x:Uid="DataStorage_CacheRetentionLabel"
                                                   Style="{StaticResource SettingsRowTitleTextStyle}"/>
                                        <TextBlock x:Uid="DataStorage_CacheRetentionDescription"
                                                   Style="{StaticResource SettingsRowDescriptionTextStyle}"/>
                                    </StackPanel>

                                    <NumberBox Grid.Column="1"
                                               AutomationProperties.AutomationId="DataStorage.CacheRetention"
                                               Value="{x:Bind ViewModel.Preferences.CacheRetentionDays, Mode=TwoWay}"
                                               Minimum="1"
                                               Maximum="60"
                                               SmallChange="1"
                                               SpinButtonPlacementMode="Inline"
                                               IsFocusEngagementEnabled="True"
                                               UseSystemFocusVisuals="True"
                                               Width="140"
                                               VerticalAlignment="Center"/>
                                </Grid>

                                <Border Height="1"
                                        Margin="16,0"
                                        Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                                <Grid Style="{StaticResource SettingsRowGridStyle}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel VerticalAlignment="Center" Spacing="4">
                                        <TextBlock x:Uid="DataStorage_CacheActionsTitle"
                                                   Style="{StaticResource SettingsRowTitleTextStyle}"/>
                                        <TextBlock x:Uid="DataStorage_CacheActionsDescription"
                                                   Style="{StaticResource SettingsRowDescriptionTextStyle}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1"
                                                Spacing="8"
                                                Margin="0,12,0,0"
                                                HorizontalAlignment="Stretch">
                                        <Button x:Uid="DataStorage_ClearCache"
                                                AutomationProperties.AutomationId="DataStorage.ClearCache"
                                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                Click="OnClearCacheClick"
                                                HorizontalAlignment="Stretch"/>
                                        <Button x:Uid="DataStorage_OpenCacheFolder"
                                                AutomationProperties.AutomationId="DataStorage.OpenCacheFolder"
                                                Command="{x:Bind ViewModel.OpenCacheFolderCommand}"
                                                IsEnabled="{x:Bind ViewModel.CanOpenExternalFiles, Mode=OneWay}"
                                                HorizontalAlignment="Stretch"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Spacing="12">
                        <TextBlock x:Uid="DataStorage_ExportTitle"
                                   Style="{StaticResource SettingsSectionTitleTextStyle}"/>

                        <Border Style="{StaticResource SettingsSectionContainerStyle}">
                            <StackPanel>
                                <Grid Style="{StaticResource SettingsRowGridStyle}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel VerticalAlignment="Center" Spacing="4">
                                        <TextBlock x:Uid="DataStorage_ExportDescription"
                                                   Style="{StaticResource SettingsRowDescriptionTextStyle}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1"
                                                Spacing="8"
                                                Margin="0,12,0,0"
                                                HorizontalAlignment="Stretch">
                                        <Button x:Uid="DataStorage_ExportMarkdown"
                                                Command="{x:Bind ViewModel.ExportCurrentSessionMarkdownCommand}"
                                                IsEnabled="{x:Bind ViewModel.CanExportLocalFiles, Mode=OneWay}"
                                                HorizontalAlignment="Stretch"/>
                                        <Button x:Uid="DataStorage_ExportJson"
                                                Command="{x:Bind ViewModel.ExportCurrentSessionJsonCommand}"
                                                IsEnabled="{x:Bind ViewModel.CanExportLocalFiles, Mode=OneWay}"
                                                HorizontalAlignment="Stretch"/>
                                    </StackPanel>
                                </Grid>

                                <Border Height="1"
                                        Margin="16,0"
                                        Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                                <Grid Style="{StaticResource SettingsRowGridStyle}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel VerticalAlignment="Center" Spacing="4">
                                        <TextBlock x:Uid="DataStorage_DiagnosticsExportTitle"
                                                   Style="{StaticResource SettingsRowTitleTextStyle}"/>
                                        <TextBlock x:Uid="DataStorage_DiagnosticsExportDescription"
                                                   Style="{StaticResource SettingsRowDescriptionTextStyle}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1"
                                                Spacing="8"
                                                Margin="0,12,0,0"
                                                HorizontalAlignment="Stretch">
                                        <Button x:Uid="DataStorage_ExportDiagnostics"
                                                Command="{x:Bind ViewModel.CreateDiagnosticsBundleCommand}"
                                                IsEnabled="{x:Bind ViewModel.CanExportLocalFiles, Mode=OneWay}"
                                                HorizontalAlignment="Stretch"/>
                                        <Button x:Uid="DataStorage_OpenExports"
                                                Command="{x:Bind ViewModel.OpenExportsFolderCommand}"
                                                IsEnabled="{x:Bind ViewModel.CanOpenExternalFiles, Mode=OneWay}"
                                                HorizontalAlignment="Stretch"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Expander IsExpanded="False"
                              Background="Transparent"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch"
                              Padding="0">
                        <Expander.Header>
                            <TextBlock x:Uid="DataStorage_DangerTitle"
                                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                       Style="{StaticResource SettingsSectionTitleTextStyle}"/>
                        </Expander.Header>

                        <StackPanel>
                            <TextBlock x:Uid="DataStorage_DangerWarning"
                                       Margin="16,4,16,8"
                                       Style="{StaticResource SettingsRowDescriptionTextStyle}"/>

                            <Border Style="{StaticResource SettingsSectionContainerStyle}">
                                <StackPanel>
                                    <Grid Style="{StaticResource SettingsRowGridStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel VerticalAlignment="Center" Spacing="4">
                                            <TextBlock x:Uid="DataStorage_ResetDefaultsTitle"
                                                       Style="{StaticResource SettingsRowTitleTextStyle}"/>
                                            <TextBlock x:Uid="DataStorage_ResetDefaultsHint"
                                                       Style="{StaticResource SettingsRowDescriptionTextStyle}"/>
                                        </StackPanel>

                                        <Button Grid.Column="1"
                                                x:Uid="DataStorage_ResetDefaults"
                                                Click="OnResetPreferencesClick"
                                                VerticalAlignment="Center"/>
                                    </Grid>

                                    <Border Height="1"
                                            Margin="16,0"
                                            Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                                    <Grid Style="{StaticResource SettingsRowGridStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel VerticalAlignment="Center" Spacing="4">
                                            <TextBlock x:Uid="DataStorage_ClearAllDataTitle"
                                                       Style="{StaticResource SettingsRowTitleTextStyle}"/>
                                            <TextBlock x:Uid="DataStorage_ClearAllDataHint"
                                                       Style="{StaticResource SettingsRowDescriptionTextStyle}"/>
                                        </StackPanel>

                                        <Button Grid.Column="1"
                                                x:Uid="DataStorage_ClearAllData"
                                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                Click="OnClearAllLocalDataClick"
                                                VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </controls:ResponsiveContentHost.Child>
        </controls:ResponsiveContentHost>
    </ScrollViewer>
    </Grid>
</views:SettingsPageBase>
