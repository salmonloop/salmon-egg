<UserControl
    x:Class="SalmonEgg.Presentation.Views.Start.HeroSuggestionCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="HeroSuggestionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Margin" Value="0,0,14,0" />
            <Setter Property="Padding" Value="18,14" />
            <Setter Property="MinWidth" Value="216" />
            <Setter Property="MinHeight" Value="112" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
        </Style>
    </UserControl.Resources>

    <Button Style="{StaticResource HeroSuggestionButtonStyle}"
            Command="{x:Bind ActionCommand, Mode=OneWay}"
            CommandParameter="{x:Bind Suggestion, Mode=OneWay}"
            AutomationProperties.AutomationId="{x:Bind AutomationId, Mode=OneWay}"
            AutomationProperties.Name="{x:Bind Title, Mode=OneWay}">
        <StackPanel Spacing="10">
            <StackPanel Orientation="Horizontal"
                        Spacing="8">
                <FontIcon Glyph="{x:Bind Icon, Mode=OneWay}"
                          FontSize="18"
                          Foreground="{ThemeResource AccentBrush}" />
                <TextBlock x:Uid="Start_QuickLaunchLabel"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}"
                       FontSize="12"
                       MaxLines="2"
                       TextWrapping="WrapWholeWords"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </Button>
</UserControl>
