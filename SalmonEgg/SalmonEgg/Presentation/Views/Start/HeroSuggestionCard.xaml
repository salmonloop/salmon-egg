<UserControl
    x:Class="SalmonEgg.Presentation.Views.Start.HeroSuggestionCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="HeroSuggestionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Margin" Value="6,4" />
            <Setter Property="Padding" Value="12,8" />
            <!-- Narrow/default: no hard min width so stacked cards shrink with the host.
                 Wide AdaptiveTrigger restores the marketing 216px tile (Min=Max) so the
                 horizontal row stays equal-width inside the 1060 window budget. -->
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MaxWidth" Value="980" />
            <Setter Property="MinHeight" Value="64" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <!-- Card width tracks StartView HeroSuggestionLayoutStates (MinWindowWidth=1060).
                 Both states set the same Target set (MinWidth + MaxWidth) so AdaptiveTrigger
                 retreat never sticks. Narrow lets stacked cards fill/shrink with the host;
                 Wide locks equal 216px tiles for the horizontal row. Theme via ThemeResource. -->
            <VisualStateGroup x:Name="HeroCardWidthStates">
                <VisualState x:Name="CardWidthNarrow">
                    <VisualState.Setters>
                        <Setter Target="HeroSuggestionButton.MinWidth" Value="0" />
                        <Setter Target="HeroSuggestionButton.MaxWidth" Value="980" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CardWidthWide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1060" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="HeroSuggestionButton.MinWidth" Value="216" />
                        <Setter Target="HeroSuggestionButton.MaxWidth" Value="216" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <!-- Card density follows StartView HeroHeightStates (MinWindowHeight=760).
                 Compact is the short-window default: icon sits beside copy in a Grid so text
                 still measures against the card width (StackPanel would give infinite width),
                 quick-launch chrome is hidden, and subtitle is single-line so three stacked
                 cards cost less vertical budget. Comfortable restores marketing density with
                 the quick-launch label and two-line subtitle. Theme via ThemeResource only. -->
            <VisualStateGroup x:Name="HeroCardHeightStates">
                <VisualState x:Name="CardHeightCompact">
                    <VisualState.Setters>
                        <Setter Target="HeroSuggestionButton.Margin" Value="6,4" />
                        <Setter Target="HeroSuggestionButton.Padding" Value="12,8" />
                        <Setter Target="HeroSuggestionButton.MinHeight" Value="64" />
                        <Setter Target="HeroSuggestionButton.CornerRadius" Value="12" />
                        <Setter Target="HeroCardRoot.ColumnSpacing" Value="10" />
                        <Setter Target="HeroCardCopy.Spacing" Value="2" />
                        <Setter Target="HeroCardIcon.FontSize" Value="16" />
                        <Setter Target="HeroCardQuickLaunchLabel.Visibility" Value="Collapsed" />
                        <Setter Target="HeroCardTitle.FontSize" Value="13" />
                        <Setter Target="HeroCardTitle.MaxLines" Value="1" />
                        <Setter Target="HeroCardSubtitle.FontSize" Value="11" />
                        <Setter Target="HeroCardSubtitle.MaxLines" Value="1" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CardHeightComfortable">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowHeight="760" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="HeroSuggestionButton.Margin" Value="7,6" />
                        <Setter Target="HeroSuggestionButton.Padding" Value="18,14" />
                        <Setter Target="HeroSuggestionButton.MinHeight" Value="112" />
                        <Setter Target="HeroSuggestionButton.CornerRadius" Value="14" />
                        <Setter Target="HeroCardRoot.ColumnSpacing" Value="12" />
                        <Setter Target="HeroCardCopy.Spacing" Value="6" />
                        <Setter Target="HeroCardIcon.FontSize" Value="18" />
                        <Setter Target="HeroCardQuickLaunchLabel.Visibility" Value="Visible" />
                        <Setter Target="HeroCardTitle.FontSize" Value="14" />
                        <Setter Target="HeroCardTitle.MaxLines" Value="2" />
                        <Setter Target="HeroCardSubtitle.FontSize" Value="12" />
                        <Setter Target="HeroCardSubtitle.MaxLines" Value="2" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Button x:Name="HeroSuggestionButton"
                Style="{StaticResource HeroSuggestionButtonStyle}"
                Command="{x:Bind ActionCommand, Mode=OneWay}"
                CommandParameter="{x:Bind Suggestion, Mode=OneWay}"
                AutomationProperties.AutomationId="{x:Bind AutomationId, Mode=OneWay}"
                AutomationProperties.Name="{x:Bind Title, Mode=OneWay}">
            <!-- Grid (not StackPanel) so the * column bounds title/subtitle for native
                 wrap/trim; icon stays Auto. Short height keeps one content row. -->
            <Grid x:Name="HeroCardRoot"
                  ColumnDefinitions="Auto,*"
                  ColumnSpacing="10">
                <FontIcon x:Name="HeroCardIcon"
                          Grid.Column="0"
                          VerticalAlignment="Top"
                          FontFamily="{ThemeResource SymbolThemeFontFamily}"
                          Glyph="{x:Bind Icon, Mode=OneWay}"
                          FontSize="16"
                          Foreground="{ThemeResource AccentBrush}" />
                <StackPanel x:Name="HeroCardCopy"
                            Grid.Column="1"
                            Spacing="2"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="HeroCardQuickLaunchLabel"
                               Text="{x:Bind CategoryLabel, Mode=OneWay}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Visibility="Collapsed"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="HeroCardTitle"
                               Text="{x:Bind Title, Mode=OneWay}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               MaxLines="1"
                               TextWrapping="WrapWholeWords"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="HeroCardSubtitle"
                               Text="{x:Bind Subtitle, Mode=OneWay}"
                               FontSize="11"
                               MaxLines="1"
                               TextWrapping="WrapWholeWords"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </Button>
    </Grid>
</UserControl>
