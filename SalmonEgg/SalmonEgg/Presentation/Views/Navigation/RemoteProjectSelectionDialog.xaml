<ContentDialog
    x:Class="SalmonEgg.Presentation.Views.Navigation.RemoteProjectSelectionDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:nav="using:SalmonEgg.Presentation.ViewModels.Navigation"
    xmlns:navViews="using:SalmonEgg.Presentation.Views.Navigation"
    mc:Ignorable="d"
    AutomationProperties.AutomationId="RemoteProjectSelectionDialog"
    DefaultButton="Primary">

    <ContentDialog.Resources>
        <Style TargetType="navViews:RemoteProjectSelectionDialog"
               BasedOn="{StaticResource DefaultContentDialogStyle}" />
        <x:Double x:Key="RemoteProjectSelectionDialogMaxWidth">560</x:Double>
        <x:Double x:Key="RemoteProjectSelectionDialogMaxHeight">560</x:Double>
        <x:Double x:Key="RemoteProjectSelectionIconSize">32</x:Double>
        <x:Double x:Key="RemoteProjectSelectionTextSpacing">2</x:Double>
        <x:Double x:Key="RemoteProjectSelectionEmptySpacing">8</x:Double>
        <Thickness x:Key="RemoteProjectSelectionItemPadding">12,10</Thickness>
    </ContentDialog.Resources>

    <Grid MaxWidth="{StaticResource RemoteProjectSelectionDialogMaxWidth}"
          MaxHeight="{StaticResource RemoteProjectSelectionDialogMaxHeight}"
          HorizontalAlignment="Stretch">
        <!-- Populated state: a single-selection list projected from the authoritative remote directories. -->
        <ListView x:Name="RemoteProjectList"
                  AutomationProperties.AutomationId="RemoteProjectSelectionDialog.List"
                  ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                  SelectionMode="Single"
                  SelectionChanged="OnSelectionChanged"
                  Visibility="{x:Bind ViewModel.HasProjects, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="nav:RemoteProjectOptionViewModel">
                    <Grid Padding="{StaticResource RemoteProjectSelectionItemPadding}"
                          AutomationProperties.Name="{x:Bind AutomationName}">
                        <StackPanel Spacing="{StaticResource RemoteProjectSelectionTextSpacing}">
                            <TextBlock Text="{x:Bind DisplayName}"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}"
                                       TextTrimming="CharacterEllipsis"
                                       MaxLines="1" />
                            <TextBlock Text="{x:Bind RemotePath}"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       MaxLines="1" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Empty state: no configured remote directories. The primary path is to open settings. -->
        <StackPanel AutomationProperties.AutomationId="RemoteProjectSelectionDialog.EmptyState"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="{StaticResource RemoteProjectSelectionEmptySpacing}"
                    Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <FontIcon Glyph="&#xE968;"
                      FontSize="{StaticResource RemoteProjectSelectionIconSize}"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                      HorizontalAlignment="Center"
                      IsHitTestVisible="False" />
            <TextBlock x:Uid="RemoteProjectSelectionEmptyTitle"
                       HorizontalAlignment="Center"
                       Style="{ThemeResource BodyStrongTextBlockStyle}" />
            <TextBlock x:Uid="RemoteProjectSelectionEmptyDescription"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Style="{ThemeResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</ContentDialog>
