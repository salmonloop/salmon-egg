<ContentDialog
    x:Class="SalmonEgg.Presentation.Views.Navigation.SessionsListDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:nav="using:SalmonEgg.Presentation.ViewModels.Navigation"
    xmlns:navUi="using:SalmonEgg.Presentation.Navigation"
    xmlns:navViews="using:SalmonEgg.Presentation.Views.Navigation"
    mc:Ignorable="d"
    x:Uid="SessionsDialog"
    AutomationProperties.AutomationId="SessionsDialog"
    Title="{x:Bind DialogTitle, Mode=OneWay}"
    DefaultButton="Close">

    <ContentDialog.Resources>
        <Style TargetType="navViews:SessionsListDialog"
               BasedOn="{StaticResource DefaultContentDialogStyle}" />
    </ContentDialog.Resources>

    <Grid x:Name="SessionsDialogRoot"
          RowDefinitions="Auto,*"
          MaxWidth="560"
          MaxHeight="360"
          HorizontalAlignment="Stretch">
        <!-- Short windows: keep dialog within viewport chrome. Comfortable restores the prior
             560px max at MinWindowHeight=760 (same threshold as Start/Settings densify). -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="SessionsDialogHeightStates">
                <VisualState x:Name="SessionsDialogHeightCompact" />
                <VisualState x:Name="SessionsDialogHeightComfortable">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowHeight="760" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SessionsDialogRoot.MaxHeight" Value="560" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <TextBox x:Uid="SessionsDialogSearchBox"
                 AutomationProperties.AutomationId="SessionsDialog.SearchBox"
                 Text="{x:Bind FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,0,0,12"/>

        <ListView Grid.Row="1"
                  AutomationProperties.AutomationId="SessionsDialog.List"
                  ItemsSource="{x:Bind FilteredSessions, Mode=OneWay}"
                  IsItemClickEnabled="True"
                  ItemClick="OnSessionItemClick"
                  SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="nav:SessionNavItemViewModel">
                    <Grid ColumnDefinitions="*,Auto,Auto"
                          Padding="12,8"
                          AutomationProperties.AutomationId="{x:Bind navUi:MainNavigationAutomationIds.SessionsDialogItem(SessionId)}">
                        <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                   TextTrimming="CharacterEllipsis"
                                   MaxLines="1"/>
                        <Ellipse Grid.Column="1"
                                 Width="8"
                                 Height="8"
                                 Fill="{ThemeResource AccentBrush}"
                                 Margin="8,0,0,0"
                                 VerticalAlignment="Center"
                                 Visibility="{x:Bind HasUnreadAttention, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <TextBlock Grid.Column="2"
                                   Text="{x:Bind RelativeTimeText, Mode=OneWay}"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Margin="12,0,0,0"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</ContentDialog>
