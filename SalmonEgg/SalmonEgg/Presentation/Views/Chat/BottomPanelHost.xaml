<UserControl
    x:Class="SalmonEgg.Presentation.Views.Chat.BottomPanelHost"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:SalmonEgg.Controls"
    mc:Ignorable="d">

    <Grid x:Name="BottomPanelRoot"
          Background="{ThemeResource LayerFillColorDefaultBrush}"
          BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
          BorderThickness="0,1,0,0">
        <!-- Short windows: densify terminal host inset so the docked bottom panel
             keeps more terminal content area. Comfortable restores 12,0,12,12 at
             MinWindowHeight=760. Keep TabView MinHeight=48 for touch targets.
             Theme via ThemeResource only. -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="BottomPanelHeightStates">
                <VisualState x:Name="BottomPanelHeightCompact">
                    <VisualState.Setters>
                        <Setter Target="TerminalHostBorder.Margin" Value="8,0,8,8" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="BottomPanelHeightComfortable">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowHeight="760" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="TerminalHostBorder.Margin" Value="12,0,12,12" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <TabView HorizontalAlignment="Stretch"
                 VerticalAlignment="Stretch"
                 IsAddTabButtonVisible="False"
                 SelectedIndex="0"
                 CanReorderTabs="False"
                 CanDragTabs="False"
                 AllowDropTabs="False"
                 TabWidthMode="SizeToContent"
                 MinHeight="48">
            <TabView.TabItems>
                <TabViewItem Header="{x:Bind TerminalTabTitle, Mode=OneWay}"
                             IsClosable="False"
                             HorizontalContentAlignment="Stretch"
                             VerticalContentAlignment="Stretch"
                             AutomationProperties.AutomationId="BottomPanelTab.terminal"
                             AutomationProperties.Name="{x:Bind TerminalTabTitle, Mode=OneWay}">
                    <TabViewItem.Content>
                        <Border x:Name="TerminalHostBorder"
                                Margin="8,0,8,8"
                                CornerRadius="12"
                                Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch">
                            <controls:XtermTerminalView HorizontalAlignment="Stretch"
                                                        VerticalAlignment="Stretch"
                                                        Session="{x:Bind EffectiveLocalTerminalSession, Mode=OneWay}"
                                                        ContentText="{x:Bind LocalTerminalContentText, Mode=OneWay}" />
                        </Border>
                    </TabViewItem.Content>
                </TabViewItem>
            </TabView.TabItems>
        </TabView>
    </Grid>
</UserControl>
