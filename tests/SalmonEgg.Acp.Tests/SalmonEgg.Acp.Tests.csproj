<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Contract tests are the only place the v2 draft surface is exercised on purpose, so the
         draft marker (AcpDraftProtocol.DiagnosticId) is silenced here rather than suppressed at
         ~90 call sites. DraftProtocolSurfaceTests asserts this entry stays in step with the
         constant: dropping it turns the analyzer build gate red instead of failing quietly. -->
    <NoWarn>$(NoWarn);SEACP002</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.MTP" Version="10.0.1" />
    <PackageReference Include="FsCheck" Version="3.3.3" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="xunit.v3.mtp-v2" Version="3.2.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SalmonEgg.Acp\SalmonEgg.Acp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\src\SalmonEgg.Acp\PublicSurface.Types.txt" Link="PublicSurface.Types.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
